# Required: your free Groq API key — get one at console.groq.com (no card needed)
GROQ_API_KEY=gsk_...

# Optional: supports forced tool calling. openai/gpt-oss-20b is a good
# default — llama-3.3-70b-versatile is being retired by Groq, don't use it.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: defaults to a local SQLite file.
# For Postgres: postgresql+psycopg2://user:pass@host:5432/mindprobe
DATABASE_URL=sqlite:///./mindprobe.db
